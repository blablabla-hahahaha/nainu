{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nainu.top/dsl/workflow-dsl.schema.json",
  "title": "Workflow DSL",
  "description": "Nainu AGI workflow 规范 DSL 的单一权威契约：结构校验、TS 类型生成与 Java 模型都以本文件为准。条件路由以 typed conditional edge 表示（edge.condition）；图级规则（START 唯一、DAG、引用可解析、ELSE 最后）由各侧图校验器实现，不在此表达。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "乐观锁：保存时 +1"
    },
    "meta": {
      "type": "object",
      "description": "工作流元数据；视图状态（位置/视口）按约定放 meta.view"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dslNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dslEdge"
      }
    }
  },
  "$defs": {
    "dslNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/dslNodeType"
        },
        "config": {
          "type": "object",
          "description": "节点参数，结构由各节点类型的 per-type schema 约束（随节点目录演进）"
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dslInputField"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dslOutputField"
          }
        }
      }
    },
    "dslEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sourceHandle": {
          "type": "string",
          "description": "多出向连接点标识；条件分支边用它区分分支"
        },
        "condition": {
          "$ref": "#/$defs/dslCondition"
        }
      }
    },
    "dslCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branchType"
      ],
      "properties": {
        "branchType": {
          "enum": [
            "IF",
            "ELIF",
            "ELSE"
          ]
        },
        "logicOperator": {
          "enum": [
            "AND",
            "OR"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dslCompare"
          }
        }
      }
    },
    "dslCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/dslInputField"
        },
        "operator": {
          "enum": [
            "EQUALS",
            "NOT_EQUALS",
            "CONTAINS",
            "NOT_CONTAINS",
            "IS_EMPTY",
            "IS_NOT_EMPTY"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "dslInputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "INTERNAL_REF",
            "CUSTOM",
            "EXTERNAL_REF"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "dslOutputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "keyAlias": {
          "type": "string",
          "description": "引用名；为空时使用 key"
        }
      }
    },
    "dslNodeType": {
      "enum": [
        "START",
        "END",
        "CONDITION",
        "DEBUG",
        "SCRIPT"
      ]
    }
  }
}
